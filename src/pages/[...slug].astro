---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, topics } from '../config/site';

const pages = {
  research: {
    title: 'Research',
    description:
      'BN Material research framework spanning experimental materials science, computation, characterization, biomaterials, energy, processing, and scientific software.',
    eyebrow: 'Research framework',
    headline: 'Mechanism-led research across materials classes and scales.',
    body: 'Research is organized around the relationships between composition, structure, processing, properties, and performance—not isolated instruments or fashionable labels.',
    metric: '12 domains',
    metricCopy: 'Connected through one multiscale engineering framework.',
    icon: 'molecular',
  },
  publications: {
    title: 'Publications',
    description: 'Verified publications and research outputs from the BN Material ecosystem.',
    eyebrow: 'Research outputs',
    headline: 'Scientific records structured for traceability.',
    body: 'Publication records are presented only when authoritative bibliographic information, persistent links, research domains, methods, and supporting context can be verified.',
    metric: 'Evidence first',
    metricCopy: 'No invented records, metrics, affiliations, or citation claims.',
    icon: 'database',
  },
  benchmarks: {
    title: 'Benchmarks',
    description:
      'Transparent materials-analysis and scientific-software benchmarks from BN Material.',
    eyebrow: 'Scientific benchmarks',
    headline: 'Comparisons that expose assumptions, versions, and limits.',
    body: 'Benchmarks are designed to document datasets, software versions, computational environments, methods, metrics, uncertainty, and interpretation together.',
    metric: 'Reproducible',
    metricCopy: 'Every comparison should be inspectable and repeatable.',
    icon: 'signal',
  },
  resources: {
    title: 'Resources',
    description:
      'Materials-engineering guides, documentation, learning resources, and workflows from BN Material.',
    eyebrow: 'Knowledge system',
    headline: 'Technical resources built around the workflow.',
    body: 'Guides and documentation connect scientific principles with analysis decisions, reproducibility, interpretation, and practical implementation.',
    metric: 'Across scales',
    metricCopy: 'From electronic structure to engineering deployment.',
    icon: 'layers',
  },
  academy: {
    title: 'Academy',
    description: 'Materials-science and scientific-software learning pathways from BN Material.',
    eyebrow: 'BN Material Academy',
    headline: 'Learn the mechanism, method, and decision logic.',
    body: 'Future learning pathways can support graduate students, laboratories, universities, and research teams across characterization, computation, materials design, data interpretation, and software practice.',
    metric: 'Method-led',
    metricCopy: 'Training focused on reasoning rather than button sequences.',
    icon: 'crystal',
  },
  consulting: {
    title: 'Consulting',
    description:
      'Independent materials-science, modeling, characterization, and scientific-software consulting.',
    eyebrow: 'Scientific consulting',
    headline: 'Technical depth for consequential materials decisions.',
    body: 'Potential engagements include research planning, characterization strategy, computational workflows, analysis-system design, scientific visualization, training, and reproducibility.',
    metric: 'Defined scope',
    metricCopy: 'Evidence requirements, boundaries, and expected outcomes are clarified first.',
    icon: 'process',
  },
  about: {
    title: 'About',
    description:
      'About BN Material, its independent scientific mission, founder, and sister-site ecosystem.',
    eyebrow: 'About BN Material',
    headline: 'An independent platform for materials intelligence and scientific software.',
    body: `BN Material is developed by ${site.founder}, affiliated with the ${site.affiliation}. It operates as an independent research and software platform; professional affiliation does not imply institutional endorsement.`,
    metric: 'Independent',
    metricCopy:
      'Research identity, software work, and professional affiliation remain clearly separated.',
    icon: 'shield',
  },
  'privacy-policy': {
    title: 'Privacy Policy',
    description: 'How BN Material handles website inquiries and visitor information.',
    eyebrow: 'Legal / privacy',
    headline: 'Minimal collection, clear purpose.',
    body: 'This static website is designed to minimize personal-data collection. Information voluntarily sent by email is used only to respond to the inquiry unless a different purpose is explicitly agreed.',
    metric: 'Minimal data',
    metricCopy: 'No advertising profile is created by the website.',
    icon: 'shield',
  },
  'terms-of-use': {
    title: 'Terms of Use',
    description: 'Terms governing use of the BN Material website and informational resources.',
    eyebrow: 'Legal / terms',
    headline: 'Use the information with scientific judgment.',
    body: 'Website materials are provided for general scientific and educational purposes. They do not replace project-specific engineering, safety, regulatory, legal, or commercial advice.',
    metric: 'Informational',
    metricCopy: 'Software access and licensing require separate written terms.',
    icon: 'layers',
  },
  disclaimer: {
    title: 'Disclaimer',
    description: 'Scientific, institutional, and software disclaimers for BN Material.',
    eyebrow: 'Legal / disclaimer',
    headline: 'Clear boundaries between evidence, interpretation, and concept.',
    body: 'Conceptual website graphics are not experimental results. Product illustrations do not establish implemented functionality. Professional affiliation identifies context and does not imply endorsement.',
    metric: 'Transparent',
    metricCopy: 'Scientific claims expand only when evidence is available.',
    icon: 'signal',
  },
};

export function getStaticPaths() {
  const slugs = [
    'research',
    'publications',
    'benchmarks',
    'resources',
    'academy',
    'consulting',
    'about',
    'privacy-policy',
    'terms-of-use',
    'disclaimer',
  ];
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const page = pages[slug as keyof typeof pages];
const principles: Array<[string, string, string]> = [
  [
    'Mechanism before description',
    'Connect observations to defensible physical, chemical, biological, or computational mechanisms.',
    'molecular',
  ],
  [
    'Scale-aware interpretation',
    'Keep electronic, atomic, nano, microstructural, component, and system scales connected.',
    'layers',
  ],
  [
    'Traceable evidence',
    'Separate measured data, calculated results, literature context, assumptions, and conceptual illustration.',
    'shield',
  ],
];
---

<Base title={page.title} description={page.description}>
  <section class="inner-hero generic-hero">
    <div class="shell inner-hero-grid">
      <div class="inner-hero-copy" data-reveal>
        <span class="kicker">{page.eyebrow}</span>
        <h1>{page.headline}</h1>
        <p>{page.body}</p>
        <div class="hero-actions">
          <a
            class="button button-accent"
            href={slug === 'research' ? '#research-domains' : '/contact'}
            ><span>{slug === 'research' ? 'Explore research domains' : 'Start a conversation'}</span
            ><Icon name={slug === 'research' ? 'arrow-down' : 'arrow-up-right'} size={17} /></a
          ><a class="button button-ghost" href="/topics"
            ><span>Materials atlas</span><Icon name="arrow-right" size={17} /></a
          >
        </div>
      </div>
      <div class="generic-hero-visual" data-reveal>
        <div class="generic-symbol"><Icon name={page.icon} size={78} strokeWidth={1.2} /></div>
        <div class="generic-lines"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="generic-metric">
          <span>BN Material / {page.title}</span><strong>{page.metric}</strong><p>
            {page.metricCopy}
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    slug === 'research' ? (
      <section class="section compact-top" id="research-domains">
        <div class="shell section-heading" data-reveal>
          <>
            <div>
              <>
                <span class="kicker">Research domains</span>
                <h2>A complete materials landscape.</h2>
              </>
            </div>
            <p>
              Each domain is linked through shared questions about synthesis, structure, mechanism,
              characterization, computation, performance, and translation.
            </p>
          </>
        </div>
        <div class="shell research-domain-list">
          {topics.map((topic, index) => (
            <a
              class:list={['research-domain-row', `accent-${topic.accent}`]}
              href={`/topics/${topic.slug}`}
              data-reveal
              data-spotlight
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div class="row-icon">
                <Icon name={topic.visual} size={24} />
              </div>
              <div>
                <h3>{topic.title}</h3>
                <p>{topic.summary}</p>
              </div>
              <div class="row-methods">
                {topic.methods.slice(0, 2).map((method) => (
                  <small>{method}</small>
                ))}
              </div>
              <Icon name="arrow-up-right" size={18} />
            </a>
          ))}
        </div>
      </section>
    ) : (
      <section class="section compact-top">
        <div class="shell section-heading" data-reveal>
          <>
            <div>
              <>
                <span class="kicker">Operating principles</span>
                <h2>Scientific clarity by design.</h2>
              </>
            </div>
            <p>
              Each section keeps claims conservative, methods visible, and the relationship between
              evidence and interpretation explicit.
            </p>
          </>
        </div>
        <div class="shell info-grid">
          {principles.map(([title, copy, icon], index) => (
            <article class="info-card" data-reveal data-spotlight>
              <div class="info-card-top">
                <span>0{index + 1}</span>
                <Icon name={icon} size={26} />
              </div>
              <h3>{title}</h3>
              <p>{copy}</p>
              {slug === 'about' && index === 2 ? (
                <a
                  class="inline-link"
                  href={site.sisterSite}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit sister site <Icon name="external" size={15} />
                </a>
              ) : (
                <a class="inline-link" href="/contact">
                  Discuss an application <Icon name="arrow-up-right" size={15} />
                </a>
              )}
            </article>
          ))}
        </div>
        {(slug === 'publications' ||
          slug === 'benchmarks' ||
          slug === 'resources' ||
          slug === 'academy') && (
          <div class="shell readiness-panel" data-reveal>
            <div>
              <span class="kicker">Publishing discipline</span>
              <h2>Records are released only when the underlying source is ready.</h2>
            </div>
            <p>
              This page intentionally avoids placeholder publications, invented metrics, unsupported
              downloads, or artificial activity. Verified material will appear with its provenance
              and scope.
            </p>
          </div>
        )}
      </section>
    )
  }
</Base>
