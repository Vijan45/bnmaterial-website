---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductVisual from '../components/ProductVisual.astro';
import { engineeringScales, products, topics } from '../config/site';

const workflow: Array<[string, string, string]> = [
  [
    'Frame the question',
    'Define the material system, evidence boundary, constraints, and decision that the work must support.',
    'layers',
  ],
  [
    'Connect the scales',
    'Relate composition, bonding, defects, interfaces, microstructure, processing, and system performance.',
    'molecular',
  ],
  [
    'Interrogate the evidence',
    'Combine calibrated experiments, computation, literature context, uncertainty, and reproducible analysis.',
    'signal',
  ],
  [
    'Translate the insight',
    'Turn mechanisms and data into defensible figures, software workflows, research plans, and engineering choices.',
    'process',
  ],
];
---

<Base
  title="BN Material"
  description="BN Material connects materials research, computation, characterization, data systems, and scientific software across scales."
>
  <section class="home-hero">
    <div class="shell hero-layout">
      <div class="hero-copy" data-reveal>
        <div class="hero-kicker">
          <span class="pulse-dot"></span>Materials intelligence · research systems · scientific
          software
        </div>
        <h1>Build better materials.<br /><em>Understand every scale.</em></h1>
        <p>
          BN Material connects experimental evidence, computational models, characterization,
          scientific visualization, and purpose-built software into one rigorous engineering
          framework.
        </p>
        <div class="hero-actions">
          <a class="button button-accent" href="/research"
            ><span>Explore the research framework</span><Icon name="arrow-up-right" size={18} /></a
          >
          <a class="button button-ghost" href="/software"
            ><span>View scientific software</span><Icon name="arrow-right" size={18} /></a
          >
        </div>
        <div class="hero-proof">
          <div><strong>12</strong><span>connected materials domains</span></div>
          <div><strong>06</strong><span>engineering scales</span></div>
          <div><strong>03</strong><span>software environments</span></div>
        </div>
      </div>

      <div class="hero-visual-wrap" data-reveal data-tilt>
        <div class="hero-visual" data-spotlight>
          <canvas id="materials-field" aria-label="Interactive conceptual materials lattice"
          ></canvas>
          <div class="visual-topbar">
            <span><i></i> Materials system map</span>
            <small>Conceptual visualization</small>
          </div>
          <div class="hero-core">
            <span class="core-ring ring-one"></span>
            <span class="core-ring ring-two"></span>
            <span class="core-ring ring-three"></span>
            <div class="core-mark"><img src="/brand/bn-monogram-mono.svg" alt="" /></div>
          </div>
          <div class="data-card data-card-a">
            <span>Structure–property path</span>
            <strong>Composition → interface → function</strong>
            <div class="mini-path"><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="data-card data-card-b">
            <span>Analysis stack</span>
            <div class="stack-bars">
              <i style="--v:82%"></i><i style="--v:61%"></i><i style="--v:73%"></i><i
                style="--v:48%"></i>
            </div>
            <small>Experiment · computation · data</small>
          </div>
          <div class="data-card data-card-c">
            <span>Scale coupling</span>
            <strong>e⁻ → atom → device</strong>
            <small>Mechanism retained across transitions</small>
          </div>
          <div class="visual-axis axis-x"><span>structure</span></div>
          <div class="visual-axis axis-y"><span>performance</span></div>
        </div>
      </div>
    </div>

    <div class="shell capability-ribbon" aria-label="Core methods">
      {
        [
          'Electronic structure',
          'Molecular dynamics',
          'X-ray diffraction',
          'Spectroscopy',
          'Microscopy',
          'Thermal analysis',
          'Materials informatics',
          'Process engineering',
        ].map((item) => (
          <span>
            <i />
            {item}
          </span>
        ))
      }
    </div>
  </section>

  <section class="section section-domains">
    <div class="shell section-heading" data-reveal>
      <div>
        <span class="kicker">Materials atlas / 12 domains</span><h2>
          A broader view of materials engineering.
        </h2>
      </div>
      <div>
        <p>
          Move beyond isolated techniques. Explore the connected scientific domains that determine
          how materials are designed, measured, modeled, processed, and deployed.
        </p><a class="inline-link" href="/topics"
          >Open the complete atlas <Icon name="arrow-up-right" size={16} /></a
        >
      </div>
    </div>

    <div class="shell domain-grid">
      {
        topics.map((topic, index) => (
          <a
            class:list={['domain-card', `accent-${topic.accent}`]}
            href={`/topics/${topic.slug}`}
            data-reveal
            data-spotlight
            data-tilt
          >
            <div class="domain-card-top">
              <>
                <span class="domain-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="domain-icon">
                  <Icon name={topic.visual} size={29} />
                </span>
              </>
            </div>
            <h3>{topic.title}</h3>
            <p>{topic.summary}</p>
            <div class="domain-methods">
              {topic.methods.slice(0, 3).map((method) => (
                <small>{method}</small>
              ))}
            </div>
            <div class="domain-card-footer">
              <>
                <span>Explore domain</span>
                <Icon name="arrow-up-right" size={17} />
              </>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section section-workflow">
    <div class="shell workflow-layout">
      <div class="workflow-intro" data-reveal>
        <span class="kicker">A rigorous operating model</span>
        <h2>From scientific question to engineering decision.</h2>
        <p>
          Every project is treated as a connected reasoning system. The goal is not more output; it
          is clearer evidence, stronger interpretation, and a workflow another researcher can
          inspect.
        </p>
        <a class="button button-dark" href="/research"
          ><span>See the complete framework</span><Icon name="arrow-up-right" size={17} /></a
        >
      </div>
      <div class="workflow-steps">
        {
          workflow.map(([title, copy, icon], index) => (
            <article data-reveal>
              <div class="step-index">
                <>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <i />
                </>
              </div>
              <div class="step-icon">
                <Icon name={icon} size={26} />
              </div>
              <div>
                <>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-software">
    <div class="shell section-heading heading-light" data-reveal>
      <div>
        <span class="kicker">Scientific software / 03 systems</span><h2>
          Analysis environments designed around real laboratory work.
        </h2>
      </div>
      <div>
        <p>
          Interfaces make assumptions, controls, annotations, comparisons, and exports
          visible—without hiding scientific decisions behind automation.
        </p><a class="inline-link" href="/software"
          >Open the software catalogue <Icon name="arrow-up-right" size={16} /></a
        >
      </div>
    </div>

    <div class="shell software-showcase">
      {
        products.map((product, index) => (
          <article class:list={['software-feature', `accent-${product.accent}`]} data-reveal>
            <div class="software-feature-copy">
              <div class="software-meta">
                <>
                  <span>0{index + 1}</span>
                  <small>{product.status}</small>
                </>
              </div>
              <span class="kicker">{product.category}</span>
              <h3>{product.name}</h3>
              <p>{product.summary}</p>
              <ul>
                {product.features.slice(0, 3).map((feature) => (
                  <li>
                    <Icon name="check" size={16} />
                    {feature}
                  </li>
                ))}
              </ul>
              <a class="button button-light" href={`/software/${product.slug}`}>
                <>
                  <span>Explore the system</span>
                  <Icon name="arrow-up-right" size={17} />
                </>
              </a>
            </div>
            <div class="software-feature-visual">
              <ProductVisual visual={product.visual} name={product.name} compact />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-scales">
    <div class="shell scales-intro" data-reveal>
      <span class="kicker">One continuum / six engineering scales</span>
      <h2>Properties emerge across scales. The analysis should too.</h2>
      <p>
        Each scale changes the dominant variables, available evidence, and engineering consequences.
        The framework keeps those transitions explicit.
      </p>
    </div>
    <div class="shell scale-track" data-reveal>
      <div class="scale-beam" aria-hidden="true"><span></span></div>
      {
        engineeringScales.map(([scale, description], index) => (
          <article>
            <span>0{index + 1}</span>
            <div class="scale-node">
              <i />
            </div>
            <h3>{scale}</h3>
            <p>{description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-principles">
    <div class="shell principles-grid">
      <article class="principle-lead" data-reveal>
        <span class="kicker">Scientific clarity by design</span>
        <h2>Evidence, computation, and interpretation remain visibly distinct.</h2>
        <p>
          Conceptual graphics are labeled. Product status is explicit. Claims expand only when
          evidence supports them.
        </p>
      </article>
      <article class="principle-card" data-reveal data-spotlight>
        <Icon name="shield" size={30} /><h3>Traceable evidence</h3><p>
          Measured data, calculated output, literature context, assumptions, and visual concepts are
          separated.
        </p>
      </article>
      <article class="principle-card" data-reveal data-spotlight>
        <Icon name="layers" size={30} /><h3>Scale-aware reasoning</h3><p>
          Electronic, atomic, nano, microstructural, component, and system behavior remain
          connected.
        </p>
      </article>
      <article class="principle-card" data-reveal data-spotlight>
        <Icon name="database" size={30} /><h3>Reproducible workflows</h3><p>
          Methods, controls, data lineage, software state, and export decisions are designed to be
          inspectable.
        </p>
      </article>
    </div>
  </section>
</Base>
