---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
---

<Base
  title="Contact"
  description="Contact BN Material about research collaboration, scientific software, materials characterization, computation, training, consulting, or technical inquiries."
>
  <section class="inner-hero contact-hero">
    <div class="shell inner-hero-grid">
      <div class="inner-hero-copy" data-reveal>
        <span class="kicker">Contact BN Material</span>
        <h1>Start a focused scientific conversation.</h1>
        <p>
          Describe the materials system, scientific question, data type, software need, or
          collaboration objective. The form prepares an email in your local mail application.
        </p>
        <div class="contact-direct">
          <span><Icon name="mail" size={18} /></span><div>
            <small>Direct email</small><a href={`mailto:${site.contactEmail}`}
              >{site.contactEmail}</a
            >
          </div>
        </div>
      </div>
      <div class="contact-scope" data-reveal>
        <span class="kicker">Useful context to include</span>
        {
          [
            'Material system and objective',
            'Available experimental or computational data',
            'Current workflow and constraints',
            'Expected output or decision',
            'Relevant platform and timeline',
          ].map((item, index) => (
            <div>
              <>
                <span>0{index + 1}</span>
                <p>{item}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section compact-top contact-section">
    <div class="shell contact-layout">
      <form class="contact-form" id="contact-form" data-reveal>
        <div class="form-head">
          <span class="kicker">Inquiry form</span><h2>Prepare a structured message.</h2><p>
            No submission is stored by this static website.
          </p>
        </div>
        <div class="form-grid">
          <div class="form-field">
            <label for="name">Name</label><input
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder="Your name"
            />
          </div>
          <div class="form-field">
            <label for="email">Email</label><input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
            />
          </div>
          <div class="form-field full">
            <label for="category">Inquiry category</label><select id="category" name="category"
              ><option>Research collaboration</option><option>Scientific software</option><option
                >Materials characterization</option
              ><option>Computational materials science</option><option
                >Consulting or training</option
              ><option>General inquiry</option></select
            >
          </div>
          <div class="form-field full">
            <label for="message">Scientific or technical context</label><textarea
              id="message"
              name="message"
              required
              placeholder="Describe the material system, objective, available data, constraints, and expected outcome."
            ></textarea>
          </div>
          <div hidden>
            <label for="website">Leave blank</label><input
              id="website"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <p class="form-note full">
            By continuing, you choose to share these details by email for the purpose of receiving a
            response.
          </p>
          <button class="button button-accent" type="submit"
            ><span>Prepare email</span><Icon name="arrow-up-right" size={17} /></button
          >
          <p id="form-status" role="status"></p>
        </div>
      </form>
      <aside class="contact-aside" data-reveal>
        <span class="kicker">Inquiry scope</span>
        <h2>Research + software + engineering.</h2>
        <p>
          Suitable discussions include materials characterization, computational workflows, research
          planning, analysis-system design, scientific visualization, training, and
          scientific-software development.
        </p>
        <div class="contact-boundary">
          <Icon name="shield" size={24} /><div>
            <strong>Privacy boundary</strong><p>
              No password, SMTP credential, or visitor submission is stored by this static website.
            </p>
          </div>
        </div>
        <a class="button button-dark" href={`mailto:${site.contactEmail}`}
          ><span>Email directly</span><Icon name="mail" size={17} /></a
        >
      </aside>
    </div>
  </section>

  <script define:vars={{ email: site.contactEmail }}>
    document.querySelector('#contact-form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget);
      if (form.get('website')) return;
      const subject = encodeURIComponent(`BN Material — ${form.get('category')}`);
      const body = encodeURIComponent(
        `Name: ${form.get('name')}\nEmail: ${form.get('email')}\n\n${form.get('message')}`,
      );
      const status = document.querySelector('#form-status');
      if (status)
        status.textContent = 'Opening your email application. Verify the recipient before sending.';
      location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    });
  </script>
</Base>
