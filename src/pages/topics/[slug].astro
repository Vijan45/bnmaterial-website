---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { engineeringScales, topics } from '../../config/site';

export function getStaticPaths() {
  return topics.map((topic, index) => ({ params: { slug: topic.slug }, props: { topic, index } }));
}

const { topic, index } = Astro.props;
const inquiryAreas = [
  {
    title: 'Core scientific questions',
    icon: 'molecular',
    copy: `How composition, bonding, defects, interfaces, morphology, and environment govern ${topic.shortTitle.toLowerCase()} behavior.`,
  },
  {
    title: 'Experimental evidence',
    icon: 'signal',
    copy: `How synthesis, calibrated characterization, controls, repeatability, and uncertainty support defensible conclusions in ${topic.shortTitle.toLowerCase()}.`,
  },
  {
    title: 'Computational interpretation',
    icon: 'database',
    copy: 'How electronic-structure calculations, atomistic simulation, continuum models, or data-driven methods can test mechanisms without replacing validation.',
  },
  {
    title: 'Engineering translation',
    icon: 'process',
    copy: 'How performance, reliability, manufacturability, safety, sustainability, and scale-up constrain useful material solutions.',
  },
];
---

<Base title={topic.title} description={topic.summary}>
  <section class:list={['inner-hero', 'domain-hero', `accent-${topic.accent}`]}>
    <div class="shell inner-hero-grid">
      <div class="inner-hero-copy" data-reveal>
        <span class="kicker">Materials domain / {String(index + 1).padStart(2, '0')}</span>
        <h1>{topic.title}</h1>
        <p>{topic.summary}</p>
        <div class="topic-tags">{topic.methods.map((method) => <span>{method}</span>)}</div>
        <div class="hero-actions">
          <a class="button button-accent" href="#domain-framework"
            ><span>Open domain framework</span><Icon name="arrow-down" size={17} /></a
          >
          <a class="button button-ghost" href="/topics"
            ><span>All domains</span><Icon name="arrow-right" size={17} /></a
          >
        </div>
      </div>
      <div class="domain-hero-visual" data-reveal data-tilt>
        <div class="domain-symbol"><Icon name={topic.visual} size={92} strokeWidth={1.15} /></div>
        <div class="domain-radar"><i></i><i></i><i></i><span></span></div>
        <div class="domain-readout readout-one">
          <small>Primary lens</small><strong>{topic.shortTitle}</strong>
        </div>
        <div class="domain-readout readout-two">
          <small>Method stack</small><strong>{topic.methods.length} connected methods</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section domain-framework" id="domain-framework">
    <div class="shell section-heading" data-reveal>
      <div>
        <span class="kicker">Mechanism to application</span><h2>
          A four-layer framework for rigorous investigation.
        </h2>
      </div>
      <p>
        The domain is treated as a connected reasoning problem: what governs the behavior, what
        evidence resolves it, what computation can test, and what deployment requires.
      </p>
    </div>
    <div class="shell inquiry-grid">
      {
        inquiryAreas.map((area, i) => (
          <article class:list={[`accent-${topic.accent}`]} data-reveal data-spotlight>
            <div class="inquiry-top">
              <>
                <span>0{i + 1}</span>
                <Icon name={area.icon} size={25} />
              </>
            </div>
            <h3>{area.title}</h3>
            <p>{area.copy}</p>
            {i === 1 && (
              <div class="inquiry-list">
                {topic.methods.map((method) => (
                  <span>
                    <Icon name="check" size={14} />
                    {method}
                  </span>
                ))}
              </div>
            )}
            {i === 3 && (
              <div class="inquiry-list scale-list">
                {engineeringScales.map(([scale]) => (
                  <span>
                    <Icon name="check" size={14} />
                    {scale}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section domain-scale-section">
    <div class="shell domain-scale-layout">
      <div data-reveal>
        <span class="kicker">Cross-scale interpretation</span><h2>
          No single scale explains the complete material.
        </h2><p>
          Analysis moves deliberately between electronic structure, atomic organization, interfaces,
          microstructure, component response, and system constraints.
        </p>
      </div>
      <div class="scale-ladder" data-reveal>
        {
          engineeringScales.map(([scale, description], i) => (
            <article>
              <>
                <span>0{i + 1}</span>
                <div>
                  <>
                    <strong>{scale}</strong>
                    <p>{description}</p>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
