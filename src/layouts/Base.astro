---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, topics, products } from '../config/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const navTopics = topics.slice(0, 6);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    founder: { '@type': 'Person', name: site.founder },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    description: site.supportingLine,
  },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f4ef" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:alt" content="BN Material — materials intelligence across scales." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og.png`} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
      const savedTheme = localStorage.getItem('bn-theme');
      if (savedTheme === 'dark' || savedTheme === 'light') {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <div class="ambient-background" aria-hidden="true">
      <span class="ambient-orb ambient-orb-a"></span>
      <span class="ambient-orb ambient-orb-b"></span>
      <span class="ambient-grid"></span>
    </div>

    <header class="site-header">
      <nav class="shell nav-shell" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="BN Material home">
          <img src="/brand/bn-material-logo.svg" alt="" width="44" height="44" />
          <span class="brand-copy">
            <strong>BN Material</strong>
            <small>Materials intelligence</small>
          </span>
        </a>

        <button
          class="menu-toggle icon-button"
          type="button"
          aria-expanded="false"
          aria-controls="nav-panel"
          aria-label="Menu"
        >
          <Icon name="menu" size={22} class="menu-icon" />
          <Icon name="close" size={22} class="close-icon" />
        </button>

        <div class="nav-panel" id="nav-panel">
          <div class="nav-links">
            <a class:list={['nav-link', { active: isActive('/') }]} href="/">Home</a>
            <details class="nav-dropdown">
              <summary class:list={['nav-link', { active: isActive('/topics') }]}
                >Domains <span>⌄</span></summary
              >
              <div class="mega-panel">
                <div class="mega-panel-intro">
                  <span class="kicker">Materials atlas</span>
                  <h2>Explore connected material systems.</h2>
                  <p>
                    Twelve research domains, linked from electronic structure to engineering
                    deployment.
                  </p>
                  <a class="inline-link" href="/topics"
                    >View all domains <Icon name="arrow-up-right" size={16} /></a
                  >
                </div>
                <div class="mega-panel-grid">
                  {
                    navTopics.map((topic) => (
                      <a href={`/topics/${topic.slug}`}>
                        <span class:list={['menu-domain-icon', `accent-${topic.accent}`]}>
                          <Icon name={topic.visual} size={20} />
                        </span>
                        <span>
                          <>
                            <strong>{topic.shortTitle}</strong>
                            <small>{topic.methods.slice(0, 2).join(' · ')}</small>
                          </>
                        </span>
                        <Icon name="arrow-up-right" size={15} />
                      </a>
                    ))
                  }
                </div>
              </div>
            </details>
            <a class:list={['nav-link', { active: isActive('/research') }]} href="/research"
              >Research</a
            >
            <details class="nav-dropdown software-dropdown">
              <summary class:list={['nav-link', { active: isActive('/software') }]}
                >Software <span>⌄</span></summary
              >
              <div class="software-panel">
                {
                  products.map((product, index) => (
                    <a href={`/software/${product.slug}`}>
                      <span>0{index + 1}</span>
                      <div>
                        <>
                          <small>{product.status}</small>
                          <strong>{product.name}</strong>
                          <p>{product.category}</p>
                        </>
                      </div>
                      <Icon name="arrow-up-right" size={16} />
                    </a>
                  ))
                }
                <a class="software-panel-all" href="/software"
                  >Open software catalogue <Icon name="arrow-right" size={16} /></a
                >
              </div>
            </details>
            <a class:list={['nav-link', { active: isActive('/publications') }]} href="/publications"
              >Publications</a
            >
            <a class:list={['nav-link', { active: isActive('/resources') }]} href="/resources"
              >Resources</a
            >
            <a class:list={['nav-link', { active: isActive('/about') }]} href="/about">About</a>
          </div>
          <div class="nav-actions">
            <button class="theme-toggle icon-button" type="button" aria-label="Switch color theme">
              <Icon name="sun" size={19} class="sun-icon" />
              <Icon name="moon" size={18} class="moon-icon" />
            </button>
            <a class="button button-dark nav-cta" href="/contact"
              ><span>Start a project</span><Icon name="arrow-up-right" size={17} /></a
            >
          </div>
        </div>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-cta" data-reveal>
        <div>
          <span class="kicker">Research · software · engineering</span>
          <h2>Turn complex materials data into defensible decisions.</h2>
        </div>
        <a class="button button-accent" href="/contact"
          ><span>Start a scientific conversation</span><Icon name="arrow-up-right" size={18} /></a
        >
      </div>

      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="BN Material home">
            <img src="/brand/bn-material-logo.svg" alt="" width="48" height="48" />
            <span class="brand-copy"
              ><strong>BN Material</strong><small>Materials intelligence</small></span
            >
          </a>
          <p>{site.supportingLine}</p>
          <a class="inline-link" href={`mailto:${site.contactEmail}`}
            >{site.contactEmail} <Icon name="arrow-up-right" size={15} /></a
          >
        </div>
        <div class="footer-column">
          <small>Explore</small>
          <a href="/topics">Materials domains</a>
          <a href="/research">Research framework</a>
          <a href="/software">Scientific software</a>
          <a href="/publications">Publications</a>
        </div>
        <div class="footer-column">
          <small>Knowledge</small>
          <a href="/resources">Resources</a>
          <a href="/benchmarks">Benchmarks</a>
          <a href="/academy">Academy</a>
          <a href="/consulting">Consulting</a>
        </div>
        <div class="footer-column">
          <small>Organization</small>
          <a href="/about">About BN Material</a>
          <a href="/contact">Contact</a>
          <a href={site.sisterSite} target="_blank" rel="noopener noreferrer"
            >Sister site <Icon name="external" size={14} /></a
          >
          <a href="/privacy-policy">Privacy policy</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} BN Material</span>
        <span>Built for traceable materials workflows</span>
        <div><a href="/terms-of-use">Terms</a><a href="/disclaimer">Disclaimer</a></div>
      </div>
    </footer>

    <script is:inline>
      const root = document.documentElement;
      const header = document.querySelector('.site-header');
      const progress = document.querySelector('.scroll-progress span');
      const menuButton = document.querySelector('.menu-toggle');
      const navPanel = document.querySelector('#nav-panel');
      const themeButton = document.querySelector('.theme-toggle');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const setTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem('bn-theme', theme);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#0a0d12' : '#f2f4ef');
        window.dispatchEvent(new CustomEvent('bn-theme-change'));
      };

      themeButton?.addEventListener('click', () =>
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'),
      );

      const closeNavigation = () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        navPanel?.classList.remove('open');
        document.body.classList.remove('nav-open');
        document
          .querySelectorAll('.nav-dropdown[open]')
          .forEach((item) => item.removeAttribute('open'));
      };

      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open));
        navPanel?.classList.toggle('open', open);
        document.body.classList.toggle('nav-open', open);
      });

      navPanel
        ?.querySelectorAll('a')
        .forEach((link) => link.addEventListener('click', closeNavigation));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeNavigation();
      });
      document.querySelectorAll('.nav-dropdown').forEach((dropdown) => {
        dropdown.addEventListener('toggle', () => {
          if (dropdown.open)
            document.querySelectorAll('.nav-dropdown').forEach((other) => {
              if (other !== dropdown) other.removeAttribute('open');
            });
        });
      });

      const onScroll = () => {
        const y = window.scrollY;
        header?.classList.toggle('scrolled', y > 18);
        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
        }
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const revealItems = document.querySelectorAll('[data-reveal]');
      if (reduceMotion.matches || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
        );
        revealItems.forEach((item, index) => {
          item.style.setProperty('--reveal-index', String(index % 5));
          revealObserver.observe(item);
        });
      }

      document.querySelectorAll('[data-spotlight]').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
          card.style.setProperty('--my', `${event.clientY - rect.top}px`);
        });
      });

      document.querySelectorAll('[data-tilt]').forEach((card) => {
        if (reduceMotion.matches) return;
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          const rx = ((event.clientY - rect.top) / rect.height - 0.5) * -3.5;
          const ry = ((event.clientX - rect.left) / rect.width - 0.5) * 4.5;
          card.style.setProperty('--rx', `${rx}deg`);
          card.style.setProperty('--ry', `${ry}deg`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });

      const canvas = document.querySelector('#materials-field');
      if (canvas instanceof HTMLCanvasElement) {
        const context = canvas.getContext('2d');
        let width = 0;
        let height = 0;
        let ratio = Math.min(window.devicePixelRatio || 1, 2);
        let nodes = [];
        let frame = 0;
        const pointer = { x: -1000, y: -1000, active: false };

        const colors = () => {
          const styles = getComputedStyle(root);
          return {
            line: styles.getPropertyValue('--canvas-line').trim() || 'rgba(98,118,255,.18)',
            node: styles.getPropertyValue('--canvas-node').trim() || '#6975ff',
            hot: styles.getPropertyValue('--canvas-hot').trim() || '#00a99d',
          };
        };

        const resize = () => {
          const rect = canvas.getBoundingClientRect();
          width = rect.width;
          height = rect.height;
          ratio = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.max(1, Math.floor(width * ratio));
          canvas.height = Math.max(1, Math.floor(height * ratio));
          context?.setTransform(ratio, 0, 0, ratio, 0, 0);
          nodes = [];
          const gap = Math.max(54, Math.min(78, width / 8));
          const rows = Math.ceil(height / (gap * 0.78)) + 2;
          const cols = Math.ceil(width / gap) + 2;
          for (let row = -1; row < rows; row += 1) {
            for (let col = -1; col < cols; col += 1) {
              const x = col * gap + (row % 2 ? gap * 0.5 : 0);
              const y = row * gap * 0.78;
              nodes.push({
                x,
                y,
                ox: x,
                oy: y,
                phase: Math.random() * Math.PI * 2,
                size: 1.3 + Math.random() * 1.9,
              });
            }
          }
        };

        const draw = (time = 0) => {
          if (!context) return;
          context.clearRect(0, 0, width, height);
          const palette = colors();
          const t = time * 0.00035;
          nodes.forEach((node) => {
            const dx = pointer.x - node.ox;
            const dy = pointer.y - node.oy;
            const distance = Math.hypot(dx, dy);
            const pull = pointer.active && distance < 170 ? (1 - distance / 170) * 15 : 0;
            node.x =
              node.ox + Math.cos(node.phase + t) * 4 + (distance ? (dx / distance) * pull : 0);
            node.y =
              node.oy +
              Math.sin(node.phase + t * 1.2) * 4 +
              (distance ? (dy / distance) * pull : 0);
          });

          context.lineWidth = 1;
          for (let i = 0; i < nodes.length; i += 1) {
            const a = nodes[i];
            for (let j = i + 1; j < Math.min(nodes.length, i + 12); j += 1) {
              const b = nodes[j];
              const d = Math.hypot(a.x - b.x, a.y - b.y);
              if (d < 88) {
                context.globalAlpha = Math.max(0.08, 0.5 - d / 190);
                context.strokeStyle = palette.line;
                context.beginPath();
                context.moveTo(a.x, a.y);
                context.lineTo(b.x, b.y);
                context.stroke();
              }
            }
          }

          nodes.forEach((node) => {
            const d = Math.hypot(pointer.x - node.x, pointer.y - node.y);
            context.globalAlpha = pointer.active && d < 115 ? 0.95 : 0.62;
            context.fillStyle = pointer.active && d < 115 ? palette.hot : palette.node;
            context.beginPath();
            context.arc(
              node.x,
              node.y,
              pointer.active && d < 115 ? node.size * 1.5 : node.size,
              0,
              Math.PI * 2,
            );
            context.fill();
          });
          context.globalAlpha = 1;
          if (!reduceMotion.matches) frame = requestAnimationFrame(draw);
        };

        canvas.addEventListener('pointermove', (event) => {
          const rect = canvas.getBoundingClientRect();
          pointer.x = event.clientX - rect.left;
          pointer.y = event.clientY - rect.top;
          pointer.active = true;
          if (reduceMotion.matches) draw();
        });
        canvas.addEventListener('pointerleave', () => {
          pointer.active = false;
          if (reduceMotion.matches) draw();
        });
        window.addEventListener(
          'resize',
          () => {
            resize();
            draw();
          },
          { passive: true },
        );
        window.addEventListener('bn-theme-change', () => draw());
        resize();
        draw();
        window.addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
      }
    </script>
  </body>
</html>
