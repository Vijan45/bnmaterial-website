---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { products } from '../../config/site';
---

<Base
  title="Scientific Software"
  description="Explore BN Material scientific software for spectroscopy, microscopy image analysis, and thermal analysis."
>
  <section class="inner-hero software-hero">
    <div class="shell inner-hero-grid">
      <div class="inner-hero-copy" data-reveal>
        <span class="kicker">Scientific software / 03 environments</span>
        <h1>Purpose-built systems for materials data.</h1>
        <p>
          Interfaces designed around traceable laboratory workflows, meaningful scientific controls,
          reproducible analysis, manual correction, and publication-ready output.
        </p>
        <div class="hero-actions">
          <a class="button button-accent" href="#catalogue"
            ><span>Explore the catalogue</span><Icon name="arrow-down" size={17} /></a
          ><a class="button button-ghost" href="/contact"
            ><span>Discuss a workflow</span><Icon name="arrow-up-right" size={17} /></a
          >
        </div>
      </div>
      <div class="software-stack-visual" data-reveal>
        {
          products.map((product, index) => (
            <div class:list={['stack-window', `window-${index + 1}`, `accent-${product.accent}`]}>
              <div>
                <>
                  <span />
                  <span />
                  <span />
                  <small>0{index + 1}</small>
                </>
              </div>
              <Icon name={product.visual} size={31} />
              <strong>{product.name}</strong>
              <small>{product.category}</small>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section compact-top" id="catalogue">
    <div class="shell section-heading" data-reveal>
      <div>
        <span class="kicker">Software catalogue</span><h2>
          Three focused environments. One transparent design philosophy.
        </h2>
      </div>
      <p>
        Current capability, development status, planned extensions, and access boundaries remain
        explicit throughout the catalogue.
      </p>
    </div>
    <div class="shell catalogue-list">
      {
        products.map((product, index) => (
          <article class:list={['catalogue-item', `accent-${product.accent}`]} data-reveal>
            <div class="catalogue-copy">
              <div class="software-meta">
                <>
                  <span>0{index + 1}</span>
                  <small>{product.status}</small>
                </>
              </div>
              <span class="kicker">{product.category}</span>
              <h2>{product.name}</h2>
              <p>{product.summary}</p>
              <div class="catalogue-features">
                {product.features.map((feature) => (
                  <span>
                    <Icon name="check" size={15} />
                    {feature}
                  </span>
                ))}
              </div>
              <a class="button button-dark" href={`/software/${product.slug}`}>
                <>
                  <span>Open product profile</span>
                  <Icon name="arrow-up-right" size={17} />
                </>
              </a>
            </div>
            <ProductVisual visual={product.visual} name={product.name} compact />
          </article>
        ))
      }
    </div>
  </section>
</Base>
