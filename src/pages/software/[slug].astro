---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { products, site } from '../../config/site';

export function getStaticPaths() {
  return products.map((product, index) => ({
    params: { slug: product.slug },
    props: { product, index },
  }));
}

const { product, index } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'ScienceApplication',
  description: product.summary,
  author: { '@type': 'Person', name: site.founder },
};
---

<Base title={product.name} description={product.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class:list={['inner-hero', 'product-hero', `accent-${product.accent}`]}>
    <div class="shell inner-hero-grid">
      <div class="inner-hero-copy" data-reveal>
        <span class="kicker">BN software / 0{index + 1} / {product.category}</span>
        <div class="status-pill"><i></i>{product.status}</div>
        <h1>{product.name}</h1>
        <p>{product.summary}</p>
        <div class="hero-actions">
          <a class="button button-accent" href="/contact"
            ><span>Discuss access or collaboration</span><Icon name="arrow-up-right" size={17} /></a
          ><a class="button button-ghost" href="#capabilities"
            ><span>Review capabilities</span><Icon name="arrow-down" size={17} /></a
          >
        </div>
      </div>
      <div class="product-hero-visual" data-reveal>
        <ProductVisual visual={product.visual} name={product.name} />
      </div>
    </div>
  </section>

  <section class="section compact-top" id="capabilities">
    <div class="shell product-capability-layout">
      <aside class="sticky-intro" data-reveal>
        <span class="kicker">Scientific workflow</span>
        <h2>Capability with visible boundaries.</h2>
        <p>
          Implemented positioning, roadmap items, access status, and scientific controls are
          separated so users can distinguish present functionality from future development.
        </p>
        <a class="inline-link" href="/contact"
          >Discuss this system <Icon name="arrow-up-right" size={16} /></a
        >
      </aside>
      <div class="capability-panels">
        <article data-reveal>
          <div class="panel-index">01</div><span class="panel-icon"
            ><Icon name={product.visual} size={26} /></span
          ><h3>Core analysis environment</h3><ul>
            {
              product.features.map((feature) => (
                <li>
                  <Icon name="check" size={16} />
                  {feature}
                </li>
              ))
            }
          </ul>
        </article>
        <article data-reveal>
          <div class="panel-index">02</div><span class="panel-icon"
            ><Icon name="process" size={26} /></span
          ><h3>Development roadmap</h3><ul>
            {
              product.planned.map((feature) => (
                <li>
                  <Icon name="arrow-right" size={15} />
                  {feature}
                </li>
              ))
            }
          </ul>
        </article>
        <article data-reveal>
          <div class="panel-index">03</div><span class="panel-icon"
            ><Icon name="shield" size={26} /></span
          ><h3>Release discipline</h3><p>
            Public downloads are not presented until executable quality, platform support,
            documentation, versioning, validation status, and licensing terms are ready for review.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section product-principles">
    <div class="shell principles-grid product-principles-grid">
      <article class="principle-lead" data-reveal>
        <span class="kicker">Interface principles</span><h2>
          Scientific control remains visible.
        </h2><p>
          Automation should accelerate analysis without erasing the reasoning required to defend the
          result.
        </p>
      </article>
      <article class="principle-card" data-reveal>
        <Icon name="signal" size={29} /><h3>Manual scientific correction</h3><p>
          Critical labels, thresholds, baselines, regions, and assignments remain reviewable.
        </p>
      </article>
      <article class="principle-card" data-reveal>
        <Icon name="database" size={29} /><h3>Structured outputs</h3><p>
          Figures, tables, annotations, settings, and project state are treated as connected
          records.
        </p>
      </article>
      <article class="principle-card" data-reveal>
        <Icon name="shield" size={29} /><h3>Conservative claims</h3><p>
          Concept interfaces do not establish implemented capability; status and roadmap remain
          explicit.
        </p>
      </article>
    </div>
  </section>
</Base>
